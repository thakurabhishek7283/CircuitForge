{
  "type": "object",
  "properties": {
    "shunt_floating": {
      "type": "boolean",
      "description": "Add a 1 GΩ shunt to ground on every node without a DC path (user circuits, ERC003),\nso the simulation still runs and the tutor can explain the problem.",
      "default": false
    },
    "analyses": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Analysis"
      },
      "description": "Override the circuit's analyses. `None` uses `circuit.analyses`, or `.op` if that is empty."
    },
    "interactive": {
      "type": "boolean",
      "description": "Without `analyses`: the editor's set, [`interactive_analyses`].",
      "default": false
    }
  },
  "title": "CompileOpts",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Analysis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "op"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "start": {
              "type": "number",
              "format": "double"
            },
            "stop": {
              "type": "number",
              "format": "double"
            },
            "step": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "dc"
            }
          },
          "required": [
            "type",
            "source",
            "start",
            "stop",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "points_per_decade": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "f_start": {
              "type": "number",
              "format": "double"
            },
            "f_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ac"
            }
          },
          "required": [
            "type",
            "points_per_decade",
            "f_start",
            "f_stop"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t_step": {
              "type": "number",
              "format": "double"
            },
            "t_stop": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "tran"
            }
          },
          "required": [
            "type",
            "t_step",
            "t_stop"
          ]
        }
      ]
    }
  }
}
